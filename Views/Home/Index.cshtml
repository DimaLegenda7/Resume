@{
    ViewData["Title"] = "Dt";
}

<main>

    <!-- HERO -->
    <section class="hero">

        <div class="hero-left">

            <div class="hero-tag">
                RESUME
            </div>

            <h1 class="hero-title">
                Привет, я <br>
                <span>Дмитрий</span>
            </h1>

            <p class="hero-description">
                Это сайт-резюме создан для демонстрации моих навыков
                и практики. Здесь представлены мои учебные проекты и работы.
            </p>

            <div class="hero-buttons">

                <a href="#contacts" class="hero-btn primary">
                    Связаться со мной
                </a>

                <a href="#projects" class="hero-btn secondary">
                    Посмотреть работы
                </a>

            </div>

        </div>

        <div class="hero-right">

            <div class="hero-image-box">
                <img src="~/images/hack.png" alt="me">
            </div>

        </div>

    </section>


    <!-- ABOUT -->
    <section id="about" class="about">

        <div class="about-left">

            <h2 class="about-title">
                Обо мне
            </h2>

            <p class="about-text">
                Начинающий разработчик, изучающий C# и .NET.
                Развиваюсь в направлении backend-разработки
                и создаю собственные проекты.
            </p>

            <p class="about-text">
                Здесь я собираю свои проекты, навыки и опыт,
                полученные во время обучения и практики.
            </p>

        </div>

        <div class="about-right">

            <div class="about-card">
                <span>1+</span>
                <p>год обучения</p>
            </div>

            <div class="about-card">
                <span>10+</span>
                <p>проектов</p>
            </div>

            <div class="about-card">
                <span>C# / .NET</span>
                <p>основной стек</p>
            </div>

        </div>

    </section>


    <!-- SKILLS -->
    <section id="skills" class="skills">

        <div class="skills-header">

            <h2>Мои навыки</h2>

            <p>
                Технологии, с которыми я работаю
            </p>

        </div>

        <div class="skills-grid">

            <div class="skill-card">
                <h3>C#</h3>

                <div class="skill-bar">
                    <div class="skill-level html"></div>
                </div>
            </div>

            <div class="skill-card">
                <h3>.NET</h3>

                <div class="skill-bar">
                    <div class="skill-level css"></div>
                </div>
            </div>

            <div class="skill-card">
                <h3>SQL</h3>

                <div class="skill-bar">
                    <div class="skill-level js"></div>
                </div>
            </div>

            <div class="skill-card">
                <h3>Git</h3>

                <div class="skill-bar">
                    <div class="skill-level git"></div>
                </div>
            </div>

        </div>

    </section>


    <!-- PROJECTS -->
    <section id="projects" class="projects">

        <div class="projects-header">

            <h2>Проекты</h2>

            <p>
                Некоторые из моих работ
            </p>

        </div>

        <div class="projects-grid">

            <div class="project-card">

                <div class="project-image">
                    <img src="~/images/project1.png" alt="project">
                </div>

                <div class="project-content">

                    <h3>Task Manager</h3>

                    <p>
                        Консольное приложение для управления задачами.
                    </p>

                    <div class="project-tags">
                        <span>C++</span>
                        <span>STL</span>
                    </div>

                    <a href="#" class="project-btn">
                        Посмотреть
                    </a>

                </div>

            </div>


            <div class="project-card">

                <div class="project-image">
                    <img src="~/images/project2.png" alt="project">
                </div>

                <div class="project-content">

                    <h3>Resume Site</h3>

                    <p>
                        Сайт-резюме на ASP.NET Core MVC.
                    </p>

                    <div class="project-tags">
                        <span>C#</span>
                        <span>ASP.NET Core</span>
                        <span>SQL</span>
                    </div>

                    <a href="#" class="project-btn">
                        Посмотреть
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- EXPERIENCE -->
    <section id="experience" class="experience">

        <div class="experience-header">

            <h2>Опыт</h2>

            <p>
                Мой путь в разработке
            </p>

        </div>

        <div class="timeline">

            <div class="timeline-item">

                <div class="dot"></div>

                <div class="content">

                    <h3>
                        Изучение C# и .NET
                    </h3>

                    <span>
                        2026 — сейчас
                    </span>

                    <p>
                        Изучаю C#, .NET, SQL и ASP.NET Core.
                        Создаю учебные проекты и разбираюсь
                        с backend-разработкой.
                    </p>

                </div>

            </div>


            <div class="timeline-item">

                <div class="dot"></div>

                <div class="content">

                    <h3>
                        C++ и Qt
                    </h3>

                    <span>
                        2026
                    </span>

                    <p>
                        Разрабатывал учебные приложения на C++,
                        изучал ООП, STL, Qt и работу с CMake.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- CONTACTS -->
    <section id="contacts" class="contacts">

        <div class="contacts-header">

            <h2>Контакты</h2>

            <p>
                Свяжитесь со мной удобным способом
            </p>

        </div>

        <div class="contacts-grid">

            <a href="mailto:example@mail.com"
               class="contact-card">

                <h3>Email</h3>

                <span>
                    example@mail.com
                </span>

            </a>


            <a href="#"
               class="contact-card">

                <h3>Telegram</h3>


            </a>


            <a href="#"
               class="contact-card">

                <h3>GitHub</h3>

                <span>
                    github.com/username
                </span>

            </a>

        </div>

    </section>

</main>